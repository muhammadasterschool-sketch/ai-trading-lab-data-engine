<?xml version="1.0" encoding="utf-8"?>
<!--
  v3.0.3 P1: API 24-30 parity for data_extraction_rules.xml (which only applies
  on Android 12+). allowBackup=false already disables Auto Backup on every API
  level; this file makes the same intent explicit for the legacy mechanism.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
