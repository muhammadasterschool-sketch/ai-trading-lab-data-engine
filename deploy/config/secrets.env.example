# AI Trading Lab — per-user secrets environment file (TEMPLATE ONLY).
#
# Copy to /var/lib/ai-trading-lab/<user>/secrets.env, set REAL values
# out-of-band, and tighten:  chown root:aitl-<user>, chmod 0600.
#
# THIS FILE IS COMMITTED TO GIT AND MUST CONTAIN NO SECRET VALUES.
# Every entry below is a NAME with an EMPTY value. The repository-wide
# secret scan (0 credential-shaped strings across all history) and
# scripts/validate_deployment_templates.py enforce this.
#
# Leave an entry EMPTY when the capability is not provisioned — the
# engine fails closed at construction when a configured secret source
# is missing; it never fabricates a credential.

# Optional data-provider API key (env-var boundary; unset = adapter
# unavailable — never guessed).
ATL_PROVIDER_API_KEY=

# Optional keyed-MAC ledger key (hex; provisioning is a governed
# operator decision — see KEYED_MAC_CUSTODY_DECISION_RECORD.md).
ATL_KEYED_MAC_KEY=

# Dashboard bind (loopback ONLY by default; public binding requires
# the operator's TLS/proxy infrastructure decision).
ATL_DASHBOARD_HOST=127.0.0.1
ATL_DASHBOARD_PORT=8017
