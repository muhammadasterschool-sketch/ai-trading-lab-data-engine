# Per-user AI Trading Lab engine service (Batch 19 template).
#
# Deployed per user:  systemctl enable --now ai-trading-lab@alice
# The %i instance identifier IS the user name.
#
# Security posture (fail-closed):
#   - dedicated least-privilege OS account (create WITHOUT a shell)
#   - systemd sandboxing (NoNewPrivileges, ProtectSystem=strict, ...)
#   - secrets injected via root-owned 0600 EnvironmentFile — NEVER
#     values inside this file (this template is committed to git)
#   - dashboard binds loopback ONLY (public exposure is a separate,
#     explicit operator infrastructure decision)
#   - resource limits + restart-on-failure (the engine is fail-closed:
#     it refuses work rather than half-running)
#
# PAPER_READY = FALSE. LIVE TRADING NOT AUTHORIZED.

[Unit]
Description=AI Trading Lab data engine (per-user instance %i) — READ-ONLY posture, paper simulation only
Documentation=file:/opt/ai-trading-lab/shared/docs/PER_USER_VPS_DEPLOYMENT.md
After=network-online.target time-sync.target
Wants=time-sync.target

[Service]
Type=exec
# -- least privilege ----------------------------------------------------
User=aitl-%i
Group=aitl-%i
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
# loopback + outbound only; no inbound exposure from this unit
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

# -- secret injection (names only here; values live in the 0600 file) ---
EnvironmentFile=/var/lib/ai-trading-lab/%i/secrets.env

# -- runtime layout ------------------------------------------------------
WorkingDirectory=/var/lib/ai-trading-lab/%i
# F-04 (Stage B hardening, 2026-10-19): ProtectSystem=strict makes the
# WHOLE filesystem read-only except /dev, /proc, /tmp (private) — the
# documented state contract (state.json, journal.jsonl, broker
# journal under /var/lib/ai-trading-lab/%i) is UNUSABLE without an
# explicit ReadWritePaths carve-out. Fresh deployments previously
# halted on first persist (EROFS).
ReadWritePaths=/var/lib/ai-trading-lab/%i
UMask=0027
# -- sandbox hardening set (F-04 completion; @system-service
#    allow-list — verified for a CPython service; Stage E VM run
#    will re-verify) ----------------------------------------------
SystemCallFilter=@system-service
SystemCallArchitectures=native
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
RestrictNamespaces=yes
CapabilityBoundingSet=
MemoryDenyWriteExecute=yes
# Reconstruction D-4 (2026-10-17): EXPLICIT long-running subcommand.
# The previous bare `-m data_engine.cli` printed help and exited 0
# (finite-command CLI), so the unit went inactive immediately.
# `serve` is the paper-mode supervisor: fail-closed startup against the
# paper readiness gate (PAPER_READY=FALSE -> refuses to start, exit 2),
# loopback-only read-only dashboard, graceful SIGTERM shutdown.
ExecStart=/opt/ai-trading-lab/%i/venv/bin/python -m data_engine.cli serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

# -- resource limits (operator-tunable) ----------------------------------
MemoryMax=512M
CPUQuota=50%
TasksMax=64

# -- output ---------------------------------------------------------------
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-trading-lab-%i

[Install]
WantedBy=multi-user.target
